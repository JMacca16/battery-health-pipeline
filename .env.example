# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=battery_pipeline
POSTGRES_USER=battery_user
POSTGRES_PASSWORD=changeme

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TELEMETRY_TOPIC=battery.telemetry
KAFKA_ALERTS_TOPIC=battery.alerts
KAFKA_CONSUMER_GROUP=battery-pipeline-consumer

# Simulation
SIM_NUM_PACKS=5
SIM_INTERVAL_SECONDS=1
SIM_ANOMALY_PROBABILITY=0.02

# Logging
LOG_LEVEL=INFO
